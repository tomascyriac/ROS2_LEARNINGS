<?xml version="1.0"?>
<package format="3">
  <name>entri_ros2_pubsub_cpp</name>
  <version>0.0.0</version>
  <description>ROS2 Publisher/Subscriber assignment with Custom Messages</description>
  <maintainer email="tomas.cyriac@gmail.com">student</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- TODO: Add missing dependencies. You will need:
       - rclcpp
       - rosidl_default_generators (buildtool_depend)
       - rosidl_default_runtime (exec_depend)
       - rosidl_interface_packages (member_of_group)
  -->
<!-- added dependencies rclcpp and std_msgs -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

<!-- added build and exec dependencies for rosidl_default_generators 
and rosidl_default_runtime -->

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
